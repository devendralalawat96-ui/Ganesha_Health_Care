# Neon Postgres — copy the pooled connection string from the Neon dashboard
DATABASE_URL="postgresql://user:password@host.neon.tech/ganesha?sslmode=require"

# Admin login (used by the seed/bootstrap route)
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-before-deploy"

# Signs the admin session cookie — generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Public site config — safe to expose, all appear in page markup
NEXT_PUBLIC_SITE_URL="https://ganeshacare.com"
# From the Google Business Profile listing
NEXT_PUBLIC_PHONE="+917974736011"
# Must be a MOBILE number — the GBP number above may be a landline, which WhatsApp cannot use
NEXT_PUBLIC_WHATSAPP="917974736011"
NEXT_PUBLIC_EMAIL="devendralalawat96@gmail.com"
NEXT_PUBLIC_UPI_ID="owner@upi"
NEXT_PUBLIC_UPI_NAME="Ganesha Home Health Care"
# Booking enquiries are emailed here via FormSubmit (free, no backend).
# The FIRST submission triggers a one-time confirmation email to this address.
NEXT_PUBLIC_BOOKING_EMAIL="devendralalawat96@gmail.com"
NEXT_PUBLIC_BOOKING_FORM_URL="https://docs.google.com/forms/d/e/REPLACE_ME/viewform?embedded=true"
NEXT_PUBLIC_GBP_REVIEW_URL="https://g.page/r/REPLACE_ME/review"
NEXT_PUBLIC_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=REPLACE_ME"

# --- Google Places API (live reviews) ---
# Optional. Without these the site falls back to the entries in src/lib/reviews.ts.
# The `reviews` field bills at the Enterprise+Atmosphere SKU (~$40 per 1,000 calls),
# so responses are cached for 24h — roughly 30 calls/month regardless of traffic.
# Create the key at console.cloud.google.com → enable "Places API (New)" → restrict it.
GOOGLE_PLACES_API_KEY=""
# Place ID for Ganesha Home Health Care Services (find via Google's Place ID Finder).
GOOGLE_PLACE_ID=""
